{
  "name": "phumindecoknoi/php-modern-learning",
  "description": "Modern PHP 8.4-8.5 learning materials with secure examples and PHPUnit 13",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Phumin Decoknoi"
    }
  ],
  "require": {
    "php": ">=8.4 <8.6",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
