{
  "name": "phumindecoknoi/php-modern-learning",
  "description": "Professional PHP 8.4-8.5 application engineering curriculum with secure examples and PHPUnit 13",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Phumin Decoknoi"
    }
  ],
  "require": {
    "php": ">=8.4 <8.6",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "suggest": {
    "ext-curl": "Required for the HTTP client and cURL lesson",
    "ext-intl": "Required for Unicode, Thai locale and internationalization examples",
    "ext-mbstring": "Recommended for multibyte string processing",
    "ext-mongodb": "Required when using the official MongoDB PHP library",
    "ext-pdo_mysql": "Required for MySQL PDO examples",
    "ext-pdo_pgsql": "Required for PostgreSQL PDO examples",
    "ext-pdo_sqlite": "Required for SQLite examples and optional tests",
    "ext-xmlreader": "Required for streaming XML examples",
    "ext-xmlwriter": "Required for streaming XML generation",
    "ext-zip": "Required for ZIP archive examples",
    "mongodb/mongodb": "Official high-level MongoDB PHP library",
    "predis/predis": "Pure PHP Redis-compatible client for cache and rate-limit examples",
    "psr/http-client": "PSR-18 HTTP client interfaces",
    "psr/http-factory": "PSR-17 HTTP factory interfaces",
    "psr/http-message": "PSR-7 HTTP message interfaces",
    "psr/log": "PSR-3 logger interfaces"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "platform": "composer check-platform-reqs",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
